# ===== 数据接入点（全部可选，不配置也能正常使用） =====

# 接入点 1：真实亚马逊评论（卖家精灵）——激活「拉取真实评论」按钮
# 申请：https://www.sellersprite.com
SELLERSPRITE_SECRET_KEY=your_sellersprite_secret_key
SELLERSPRITE_MCP_URL=https://mcp.sellersprite.com/mcp
SELLERSPRITE_API_URL=https://api.sellersprite.com

# 接入点 2：大模型分析引擎（任何 OpenAI 兼容接口）
# 不配置时自动使用内置本地分析引擎（免密钥出卡）
ANALYZE_API_URL=https://api.stepfun.com/step_plan/v1/chat/completions
ANALYZE_MODEL=step-3.7-flash
ANALYZE_API_KEY=your_llm_api_key

# 强制使用本地引擎（即使配置了上面的密钥也不调用大模型）
# ANALYZE_ENGINE=local
